# Copy this file to .env and fill in the values. Never commit the real .env.

# Port the Express server listens on
PORT=4000

# Frontend address, used for CORS
CLIENT_URL=http://localhost:3000

# Supabase Postgres connection string (Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Supabase project (Settings > API). The service role key is backend only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key